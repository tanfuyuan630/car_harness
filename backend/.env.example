# OpenAI 兼容端点配置（默认指向 DashScope 通义千问兼容模式）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen3.8-max-0902
# 以下为可选模型参数，不设置则使用模型默认值。
# 注意：kimi-k3 不支持 temperature，请勿设置。
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
# LLM_TOP_P=0.9

# ---------------- 多层模型路由 ----------------
# 默认关闭；开启后按问题复杂度选择模型档位，修改后需重启服务生效。
LLM_TIER_ENABLED=false
LLM_TIER_HIGH_MODEL=qwen3.8-max-0902
LLM_TIER_MEDIUM_MODEL=qwen-plus
LLM_TIER_LOW_MODEL=qwen-turbo
LLM_CLASSIFIER_MODEL=qwen-turbo
LLM_CLASSIFIER_MAX_TOKENS=200

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据路径（相对 backend 目录）
DATA_DIR=../data

# 文件系统后端：local | memory
FILESYSTEM_BACKEND=local
WORKSPACE_DIR=./workspace

# Checkpointer 类型：redis | memory（memory 仅用于测试，不持久化）
CHECKPOINTER_TYPE=redis

# ---------------- MySQL 数据库配置 ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=car_harness

# ---------------- JWT 鉴权配置 ----------------
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------- Redis 检查点 ----------------
# 需要 Redis 8.0（内置 RedisJSON/RediSearch），或自行安装这两个模块
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
# 检查点默认保留 3 天（分钟），读取时自动续期
REDIS_CHECKPOINT_TTL_MINUTES=4320
# 维护任务扫描间隔（秒）：未完成任务续期，已完成且超期的任务清理
REDIS_MAINTENANCE_INTERVAL_SECONDS=3600
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_RETRY_ATTEMPTS=3

# ---------------- 错误恢复 ----------------
# 临时错误重试次数（限流、超时、连接失败）
LLM_MAX_RETRIES=3
# 工具可恢复错误回到 Agent 的最大次数，超过后转致命错误
MAX_RECOVERABLE_RETRIES=2
# 单次模型请求超时（秒）
OPENAI_TIMEOUT_SECONDS=120

# ---------------- 依赖降级 ----------------
# 总开关：默认开启。关闭后模型、RAG、检查点、子 Agent 异常时按原策略报错。
DEGRADE_ENABLED=true
# 强制降级：四项全部强制生效，用于演练与应急。修改后需重启服务。
DEGRADE_FORCE=false
# RAG 故障后的冷却窗口（秒），窗口内检索直接返回空结果，不重复调用底层依赖
RAG_DEGRADE_COOLDOWN_SECONDS=60

# ---------------- RAG 知识库 ----------------
# 是否启用知识库工具
RAG_ENABLED=true
# 知识库根目录（相对 DATA_DIR，逗号分隔，递归扫描，支持 md/doc/docx）
RAG_KNOWLEDGE_DIRS=docs,insurance
# Chroma 持久化目录（相对 DATA_DIR）与集合名
RAG_CHROMA_DIR=chroma_db
RAG_COLLECTION=car_knowledge
# 旧版 doc 转换缓存目录（相对 backend 目录）
RAG_CACHE_DIR=.cache/rag_docs
# embedding / rerank 模型
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_RERANK_MODEL=qwen3.7-text-rerank
RAG_RERANK_ENABLED=true
# 可选能力：BM25 混合检索、查询改写，默认关闭
RAG_HYBRID_ENABLED=false
RAG_QUERY_REWRITE_ENABLED=false
RAG_REWRITE_NUM_QUERIES=3
# 检索参数：召回数、重排保留数、分块大小与重叠
RAG_RETRIEVE_TOP_K=10
RAG_RERANK_TOP_N=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ---------------- 高德地图 ----------------
# 高德地图 Web 服务 API Key，用于地理编码与路径规划
AMAP_WEBSERVICE_KEY=

# ---------------- ACP 文件生成链路 ----------------
# 通过 Agent Client Protocol 调用本地 ACP 兼容工具（如 qwen、traecli）生成文件。
# 开启前需安装对应命令行工具并完成登录。
ACP_ENABLED=false
ACP_COMMAND=qwen
ACP_ARGS=--acp
ACP_TIMEOUT_SECONDS=300

# ---------------- IM 渠道 ----------------
# 飞书渠道：默认关闭。开启前需在飞书开放平台创建企业自建应用，
# 开启机器人能力并订阅 im.message.receive_v1 事件（长连接接收方式）。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
